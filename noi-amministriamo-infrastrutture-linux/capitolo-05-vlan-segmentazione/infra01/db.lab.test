@   IN  SOA infra01.lab.test. hostmaster.lab.test. (
        2026101601 ; serial
        3600       ; refresh
        900        ; retry
        604800     ; expire
        300        ; negative cache TTL
)

    IN  NS  infra01.lab.test.

fw01            IN  A      10.77.0.1
