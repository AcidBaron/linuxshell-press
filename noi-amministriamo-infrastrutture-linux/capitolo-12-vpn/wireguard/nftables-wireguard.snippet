# Estratto dalla configurazione finale validata /etc/nftables.conf

define WG_IF = "wg0"
define WG_NET = 10.99.10.0/24

# chain input
iifname $WAN_IF udp dport 51820 accept

# SSH dal tunnel WireGuard
iifname $WG_IF ip saddr $WG_NET tcp dport 22 accept

# chain forward
iifname $WG_IF oifname $LAN_IF \
    ip saddr $WG_NET ip daddr $LAN_NET \
    counter accept
